# 이 파일을 복사해 같은 폴더에 .env 로 저장한 뒤 값을 채운다.
#   Windows : copy .env.example .env
#   macOS / Linux : cp .env.example .env
# .env 는 형상관리에 올리지 않는다. (키가 들어 있다)

# SSAFY GMS 키 (https://gms.ssafy.io/web/)
GMS_KEY=

# 외부 API User-Agent에 넣을 연락처 (영문 이메일)
# 위키백과 · Wikidata 정책상 사실상 필수다. 없으면 호출 한도가 크게 줄어든다.
WIKI_CONTACT=

# 설정 파일 경로 (선택) — 청크 크기 · Top-k 비교 실험 때 다른 설정 파일을 지정한다.
# VH_CONFIG=config.toml
