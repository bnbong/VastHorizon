# 이 파일을 복사해 같은 폴더에 .env 로 저장한 뒤 값을 채운다.
#   Windows : copy .env.example .env
#   macOS / Linux : cp .env.example .env
# .env 에는 키가 들어 있으므로 형상관리에 올리지 않는다.

# Claude API 키 (https://console.anthropic.com/). 기본 설정(config.deploy.toml)에서 쓴다. ANTHROPIC_API_KEY라는 이름으로 넣어도 읽는다.
CLAUDE_API_KEY=

# 외부 API User-Agent에 넣을 연락처 (영문 이메일)
# 위키백과 · Wikidata 정책상 사실상 필수다. 없으면 호출 한도가 크게 줄어든다.
WIKI_CONTACT=

# 설정 파일 경로. Claude + 로컬 임베딩으로 실행하려면 config.deploy.toml을 지정한다.
# 지정하지 않으면 config.toml(OpenAI 호환 엔드포인트)을 쓴다.
# VH_CONFIG=config.deploy.toml

# 선택: config.toml로 다른 OpenAI 호환 API를 쓸 때 넣는 키
# GMS_KEY=

# 선택: 카카오톡 공유("카카오톡으로 보내기") JavaScript 키 (https://developers.kakao.com 앱 키). 비우면 버튼을 숨긴다.
# 서버가 index.html의 vh-kakao-key meta에 넣어 내보낸다. 앱의 Web 플랫폼에 접속 주소(예: http://localhost:8000)를 등록해 둔다.
KAKAO_JS_KEY=
