# VM2 VastHorizon .env 템플릿
#
# /opt/bnbong/vasthorizon/.env로 복사해 값을 채운다. 채운 파일은 저장소에 올리지 않는다.
#   cp env.template /opt/bnbong/vasthorizon/.env && chmod 600 /opt/bnbong/vasthorizon/.env
#
# 이 파일은 두 가지로 쓰인다.
#   - compose 변수 치환: VM2_PRIVATE_IP, VM1_PRIVATE_IP, VASTHORIZON_IMAGE
#   - 컨테이너 환경변수(env_file): CLAUDE_API_KEY, WIKI_CONTACT

# [필수] Claude API 키. 비어 있으면 API는 뜨지만 질문에 답하지 못한다 (/api/health에서 확인).
CLAUDE_API_KEY=

# [권장] 위키백과, Wikidata 요청의 User-Agent에 넣을 연락처 (메일 주소 등).
WIKI_CONTACT=

# [필수] 포트를 게시할 VM2 private IP. VM1 Nginx가 이 주소의 8020으로 /api/를 프록시한다.
# 비우면 compose가 중단된다. public IP나 0.0.0.0을 적지 않는다.
VM2_PRIVATE_IP=10.0.1.60

# [필수] X-Forwarded-For를 믿을 VM1 Nginx의 private IP (FORWARDED_ALLOW_IPS로 들어간다).
# 이 주소가 틀리면 사용자 주소가 모두 VM1 주소 하나로 묶여 AI 호출 한도를 함께 쓰게 된다.
# "*"처럼 넓게 적으면 원본 포트에 닿은 쪽이 자기 주소를 속일 수 있다.
VM1_PRIVATE_IP=10.0.1.133

# [선택] 실행할 image. 비우면 ghcr.io/bnbong/vasthorizon:main을 쓴다.
# 특정 버전에 고정하려면 태그나 digest를 적는다 (예: ghcr.io/bnbong/vasthorizon@sha256:...).
VASTHORIZON_IMAGE=
